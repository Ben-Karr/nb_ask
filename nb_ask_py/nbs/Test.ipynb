      ")\n",
      "\u001b[31mSource:\u001b[39m   \n",
      "\u001b[38;5;28;01mdef\u001b[39;00m view_file(\n",
      "    path:str, \u001b[38;5;66;03m# Path to view (expands `~` if needed)\u001b[39;00m\n",
      "    start_line:int=\u001b[32m1\u001b[39m, \u001b[38;5;66;03m# Starting line to view\u001b[39;00m\n",
      "    end_line:int=\u001b[38;5;28;01mNone\u001b[39;00m, \u001b[38;5;66;03m# End line (defaults to last line if None; may be past EOF, which clamps to the last line - handy when the file size is unknown)\u001b[39;00m\n",
      "    lnhashs:bool=\u001b[38;5;28;01mFalse\u001b[39;00m \u001b[38;5;66;03m# Prefix `lineno|hash|` exhash addresses instead of `lineno: `\u001b[39;00m\n",
      "):\n",
      "    \u001b[33m\"Read file contents, optionally limited to 1-based line range\"\u001b[39m\n",
      "    path = Path(path).expanduser()\n",
      "    lines = path.read_text().splitlines()\n",
      "    \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28;01mnot\u001b[39;00m lines: \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[33m''\u001b[39m\n",
      "    \u001b[38;5;28;01mif\u001b[39;00m end_line \u001b[38;5;28;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m: end_line = len(lines)\n",
      "    \u001b[38;5;28;01mif\u001b[39;00m end_line < \u001b[32m0\u001b[39m: end_line = len(lines)+end_line+\u001b[32m1\u001b[39m\n",
      "    \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28;01mnot\u001b[39;00m (\u001b[32m1\u001b[39m <= start_line <= len(lines)): \u001b[38;5;28;01mreturn\u001b[39;00m f'error: Invalid start_line {start_line}. Valid range: 1-{len(lines)}'\n",
      "    \u001b[38;5;28;01mif\u001b[39;00m end_line > len(lines): end_line = len(lines)\n",
      "    \u001b[38;5;28;01mreturn\u001b[39;00m PrettyString(\u001b[33m'\\n'\u001b[39m.join((lnhash(i,l) \u001b[38;5;28;01mif\u001b[39;00m lnhashs \u001b[38;5;28;01melse\u001b[39;00m f'{i}: ')+l \u001b[38;5;28;01mfor\u001b[39;00m i,l \u001b[38;5;28;01min\u001b[39;00m enumerate(lines[start_line-\u001b[32m1\u001b[39m:end_line], start_line)))\n",
