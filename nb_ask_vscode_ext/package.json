{
    "name": "nbAsk",
    "displayName": "Notebook Ask",
    "description": "",
    "version": "0.1.14",
    "engines": {
        "vscode": "^1.125.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onNotebook:ipynb"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "nb_ask.start",
                "title": "NbAsk: Start Server"
            },
            {
                "command": "nb_ask.stop",
                "title": "NbAsk: Stop Server"
            },
            {
                "command": "nb_ask.edit_output",
                "title": "NbAsk: Edit response output"
            },
            {
                "command": "nb_ask.open_settings",
                "title": "NbAsk: Open Settings"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "nbAsk",
                    "title": "NbAsk",
                    "icon": "media/nbask.svg"
                }
            ]
        },
        "views": {
            "nbAsk": [
                {
                    "type": "webview",
                    "id": "nbAsk.settingsView",
                    "name": "Settings",
                    "icon": "media/nbask.svg"
                }
            ]
        },
        "configuration": {
            "title": "NbAsk",
            "properties": {
                "nbAsk.port": {
                    "type": "number",
                    "default": 3144
                },
                "nbAsk.model": {
                    "type": "string",
                    "default": ""
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.125.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "typescript-eslint": "^8.61.1",
        "eslint": "^10.5.0",
        "typescript": "^6.0.3",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/you/nb_ask"
    },
    "license": "SEE LICENSE IN ../LICENSE",
    "publisher": "your-publisher-id",
    "keywords": [
        "notebook",
        "llm"
    ]
}
